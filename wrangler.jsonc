{
  "name": "rustismylife",
  "compatibility_date": "2026-01-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "analytics_engine_datasets": [
    { "binding": "RUSTISMYLIFE_ANALYTICS", "dataset": "rustismylife_analytics" }
  ]
}
